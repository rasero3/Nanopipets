
(rules PCB freerouting.dsn
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute off)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 1)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.8)
      (against_preferred_direction_trace_costs 4.4)
    )
    (layer_rule In1.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.4)
    )
    (layer_rule In2.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.6)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.8)
      (against_preferred_direction_trace_costs 4.2)
    )
  )
  (rule
    (width 150.0)
    (clearance 140.0)
    (clearance 75.0 (type smd_to_turn_gap))
    (clearance 35.0 (type smd))
    (clearance 140.0 (type "kicad_default"))
  )
  (padstack "Via[0-3]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-3]_600:300_um" "Via[0-3]_600:300_um" default
  )
  (via 
    "Via[0-3]_600:300_um-kicad_default" "Via[0-3]_600:300_um" "kicad_default"
  )
  (via_rule
    default "Via[0-3]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-3]_600:300_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 150.0)
    )
    (circuit 
      (use_layer F.Cu In1.Cu In2.Cu B.Cu)
    )
  )
  (class "kicad_default"
    +3.3VD +5V GND +3.3VCCA "+3.3V_USB" +1.8VD /Ethernet/Ethernet.RX2 "+3.3VA_ADC"
    "+2.5V_ETH" "+3.3VD_ADC" "Net-(T1-CD3)" /ADC1/ADC1.SDOC /ADC1/ADC1.SDOA /ADC1/ADC1.CS /ADC2/ADC2.CS /ADC2/ADC2.SDOA
    /ADC2/ADC2.SDOC /Connectors/OUT2 /DAC/DAC.SDI "Net-(Q2-B)" /ADC1/IN3 /ADC1/IN2 /ADC1/IN4 /ADC2/IN5
    /ADC2/IN7 /ADC2/IN6 /ADC2/IN8 /Connectors/OUT3 /Connectors/OUT5 "Net-(IC16-X_I)" /Connectors/JTAG.TMS /Connectors/UART.RX
    "Net-(R66-Pad2)" "Net-(PS1-SS)" "2.5V_REF" "+1.1V_ETH" "Net-(T1-CD1)" "Net-(T1-CD2)" "Net-(T1-CD4)" /ADC1/ADC1.SDOD
    /ADC1/ADC.SDI /ADC1/ADC1.SDOB /ADC2/ADC2.SDI /ADC2/ADC2.SDOB /ADC2/ADC2.SDOD /Connectors/OUT1 /DAC/DAC.SCLK /DAC/DAC.SDO
    /Connectors/JTAG.TCK "/Ethernet/Ethernet.TX_CTRL" /Connectors/NSTATUS /Ethernet/Ethernet.MDC /Ethernet/Ethernet.RX3 /Ethernet/Ethernet.RX1 "/Ethernet/Ethernet.GTX_CLK" /Ethernet/Ethernet.MDIO
    "/Connectors/CONF_DONE" "/Connectors/CONFIG_SEL" "/Ethernet/Ethernet.RX_CTRL" "/Ethernet/Ethernet.RX_CLK" /Ethernet/Ethernet.RX0 /Ethernet/Ethernet.TX2 /DAC/OUT7 /DAC/OUT1
    /DAC/OUT8 /Ethernet/Ethernet.TX3 /DAC/OUT6 /DAC/OUT5 /DAC/OUT4 /DAC/OUT3 /DAC/OUT2 /Ethernet/Ethernet.TX0
    /Ethernet/Ethernet.TX1 /Connectors/NCONFIG /Connectors/LED2 /Connectors/LED0 "/Connectors/TD_M_C" "/Connectors/TD_P_B" "/Connectors/TD_P_A" "/Connectors/TD_M_B"
    "/Connectors/TD_M_D" "/Connectors/TD_M_A" /Connectors/LED1 "/Connectors/TD_P_C" "/Connectors/TD_P_D" "Net-(LED1-A)" "Net-(LED1-K)" "unconnected-(PS1-NC_10-Pad42)"
    "unconnected-(PS1-EAIN-Pad38)" "unconnected-(PS1-COMP-Pad40)" "unconnected-(PS1-NC_1-Pad1)" "unconnected-(PS1-NC_5-Pad16)" "unconnected-(PS1-NC_6-Pad25)" "unconnected-(PS1-NC(SW)_1-Pad4)" "unconnected-(PS1-ROCP-Pad27)" "unconnected-(PS1-NC_2-Pad2)"
    "unconnected-(PS1-NC_9-Pad31)" "unconnected-(PS1-NC_7-Pad26)" "unconnected-(PS1-NC_11-Pad43)" "unconnected-(PS1-NC(SW)_2-Pad5)" "unconnected-(PS1-NC_4-Pad7)" "unconnected-(PS1-EAOUT-Pad39)" "unconnected-(PS1-NC(SW)_4-Pad15)" "unconnected-(PS1-NC_8-Pad30)"
    "unconnected-(PS1-NC_3-Pad3)" "unconnected-(PS1-NC(SW)_3-Pad6)" "unconnected-(PS1-NC_12-Pad44)" "Net-(Q1-C)" "Net-(Q2-C)" /Connectors/IN1 /Connectors/IN3 /Connectors/IN2
