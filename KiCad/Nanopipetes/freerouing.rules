    /Connectors/OUT4 /Connectors/OUT6 "Net-(C82-Pad1)" "Net-(C83-Pad1)" /Connectors/OUT8 "Net-(IC16-X_O)" "Net-(U9-~{RESET})" "Net-(IC1-+)"
    "unconnected-(IC1-NC-Pad8)" "unconnected-(IC1-NC-Pad5)" "unconnected-(IC1-NC-Pad1)" "unconnected-(IC2-NIC_2-Pad3)" "unconnected-(IC2-NIC_3-Pad5)" "unconnected-(IC2-NIC_1-Pad1)" "unconnected-(IC2-NIC_4-Pad7)" "unconnected-(IC2-DNC-Pad8)"
